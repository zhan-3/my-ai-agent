# 环境变量模板：复制为 .env 后填入真实值
#   cp .env.example .env
# 注意：.env 含密钥，已被 .gitignore 忽略、勿提交；本模板可安全提交

# LLM 主模型（必填：意图识别 / 行程规划 / 联网问答）
#   DEEPSEEK_BASE_URL 例：https://api.deepseek.com（官方或 OpenAI 兼容中转）
#   DEEPSEEK_MODEL    例：deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# 向量化模型（必填：知识问答 RAG，阿里云百炼 text-embedding-v3）
DASHSCOPE_API_KEY=

# JWT 认证密钥（可选：不设则用开发默认值；生产务必覆盖）
# 生成：openssl rand -hex 32
JWT_SECRET=

# Postgres 持久化记忆（可选：不设则用内存后端，重启即失）
# 本地起库：docker compose up -d postgres
POSTGRES_URL=
