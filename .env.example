# ============================================================
# 晓问 · 差旅出行助手 环境变量模板
# 用法：cp .env.example .env  然后填入真实值
# （.env 已被 .gitignore 忽略，不会入库；本模板可放心提交）
# ============================================================

# ---- LLM 主模型（必填：意图识别 / 行程规划 / 联网问答）----
DEEPSEEK_API_KEY=你的Key
DEEPSEEK_BASE_URL=https://...          # 模型服务地址（官方或 OpenAI 兼容中转）
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 向量化（知识问答 RAG 用，阿里云百炼 text-embedding-v3）----
DASHSCOPE_API_KEY=你的Key

# ---- 可选：JWT 认证密钥（不设则用开发默认值；生产务必覆盖）----
# 生成：openssl rand -hex 32
JWT_SECRET=

# ---- 可选：Postgres 持久化记忆（不设则用内存后端，重启即失）----
# 起库：docker compose up -d postgres
POSTGRES_URL=postgresql://postgres:123456@localhost:5432/xiao_wen
