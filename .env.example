# 环境变量模板：复制为 .env 后填入真实值
#   cp .env.example .env
# 注意：.env 含密钥，已被 .gitignore 忽略、勿提交；本模板可安全提交

# LLM 主模型（必填：意图识别 / 行程规划 / 联网问答）
#   DEEPSEEK_BASE_URL 例：https://api.deepseek.com（官方或 OpenAI 兼容中转）
#   DEEPSEEK_MODEL    当前配置示例：deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# 向量化模型（必填：知识问答 RAG；切换模型会自动重建本地索引）
DASHSCOPE_API_KEY=
DASHSCOPE_EMB_MODEL=text-embedding-v4
DASHSCOPE_EMB_DIM=1024

# JWT 认证密钥（Web 启动必填，至少 32 字节；空值/短值/公开默认值会拒绝启动）
# 生成：openssl rand -hex 32
JWT_SECRET=

# Postgres 持久化记忆（唯一后端，Web 启动必填）
# 本地起库：docker compose up -d postgres
POSTGRES_URL=

# 测试库不要写入 .env；运行 scripts/init_test_db.sh 后按输出在当前 shell 导出
# POSTGRES_TEST_URL，门禁不会回退到开发库。
